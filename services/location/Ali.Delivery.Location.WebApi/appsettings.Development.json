{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "%BaseDirectory%\\Logs\\log-.txt",
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact",
          "rollingInterval": "Day",
          "fileSizeLimitBytes": "10485760",
          "rollOnFileSizeLimit": true
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:9051",
          "compact": true
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithExceptionDetails"
    ],
    "Properties": {
      "ApplicationName": "LocationService"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "AppDbContext": "Host=localhost;Port=9050;Database=location-service;Username=postgres;Password=postgres;Include Error Detail=true"
  },
  "BotConfiguration": {
    "Token": "",
    "StateTransitions": {
      "Initial": {
        "OnStart": {
          "NextState": "WaitingAuthCommand",
          "Notification": "N1_Welcome" 
        }
      },
      "WaitingAuthCommand": {
        "OnLogin": {
          "NextState": "WaitingCredentials",
          "Notification": "N0_EnterCredentials" 
        },
        "OnInvalidCommand": {
          "NextState": "WaitingAuthCommand",
          "Notification": "N1_InvalidAuthCommand" 
        }
      },
      "WaitingCredentials": {
        "OnValidCredentials": {
          "NextState": "Authenticated",
          "Notification": "N4_AuthenticationComplete"
        },
        "OnInvalidCredentials": {
          "NextState": "WaitingCredentials",
          "Notification": "N2_InvalidCredentials"
        },
        "OnRegistrationRequired": {
          "NextState": "RegistrationRequired",
          "Notification": "N3_RegistrationRequired"
        }
      },
      "Authenticated": {
        "OnGeosharing": {
          "NextState": "GeosharingActive",
          "Notification": "N5_RequestLocation"
        },
        "OnStop": {
          "NextState": "Terminated",
          "Notification": "N_SessionEnded" 
        }
      },
      "GeosharingActive": { 
        "OnLocationReceived": {
          "NextState": "GeosharingActive", 
          "Notification": "N6_LocationReceived" 
        },
        "OnInvalidLocation": {
          "NextState": "GeosharingActive", 
          "Notification": "N7_InvalidLocation"
        },
        "OnStop": {
          "NextState": "Terminated",
          "Notification": "N_SessionEnded"
        }
      },
      "Terminated": {
        "OnStart": { 
          "NextState": "WaitingAuthCommand",
          "Notification": "N1_Welcome"
        }
      },
      "RegistrationRequired": {
        "OnLoginAttempt": {
          "NextState": "WaitingCredentials",
          "Notification": "N0_EnterCredentials"
        },
        "OnStop": {
          "NextState": "Terminated",
          "Notification": "N_SessionEnded"
        }
      }
    }
  },
  "ExternalServices": {
    "OrderService": "http://localhost:5091/",
    "LocationService": "http://localhost:5287/"
  }
}

