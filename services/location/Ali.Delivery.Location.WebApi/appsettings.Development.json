{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "%BaseDirectory%\\Logs\\log-.txt",
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact",
          "rollingInterval": "Day",
          "fileSizeLimitBytes": "10485760",
          "rollOnFileSizeLimit": true
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:9051",
          "compact": true
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithExceptionDetails"
    ],
    "Properties": {
      "ApplicationName": "LocationService"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "AppDbContext": "Host=localhost;Port=9050;Database=location-service;Username=postgres;Password=postgres;Include Error Detail=true"
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "Port": 9061,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "MaxRetryAttempts": 1,
    "RetryDelaySeconds": 1,
    "EnablePublisherConfirms": false,
    "PublishTimeoutSeconds": 5,
    "Exchanges": {
      "user": {
        "Name": "location.exchange",
        "Type": "direct",
        "Durable": true,
        "AutoDelete": false
      }
    },
    "Queues": {
      "userCreated": {
        "Name": "location.created.queue",
        "Exchange": "location.exchange",
        "RoutingKey": "location.created",
        "Durable": true,
        "Exclusive": false,
        "AutoDelete": false
      }
    }
  },
  "ExternalServices": {
    "OrderService": "http://localhost:5091/",
    "LocationService": "http://localhost:5287/"
  },
  "TelegramToken": ""
}

